# Primary AI provider: OpenRouter (OpenAI-compatible).
# The key stays server-side in /api/explain.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# Optional attribution / site URL sent to OpenRouter.
# On Vercel you can leave this empty; VERCEL_URL is used automatically.
OPENROUTER_SITE_URL=

# Optional fallback provider. Used only when OPENROUTER_API_KEY is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
